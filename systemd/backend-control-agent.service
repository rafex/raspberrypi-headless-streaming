[Unit]
Description=Agente outbound para control remoto desde Streaming API
Documentation=https://github.com/rafex/raspberrypi-headless-streaming
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/raspi-streaming/backend-control-agent.env
WorkingDirectory=__REPO_DIR__
ExecStart=/usr/bin/env python3 __REPO_DIR__/scripts/backend-control-agent.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backend-control-agent

[Install]
WantedBy=multi-user.target
