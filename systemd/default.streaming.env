# Defaults versionados para /etc/streaming.env.
#
# No guardar secretos aqui. STREAM_KEY, STREAM_KEY_META y destinos secundarios
# se preservan desde el archivo local de la Raspberry Pi con:
#
#   sudo ./scripts/apply-streaming-defaults.py

RTMP_URL=rtmp://a.rtmp.youtube.com/live2
STREAM_PLATFORM=youtube
STREAM_DUAL=false

STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
STREAM_BITRATE=4500000
STREAM_PRESET=veryfast

VIDEO_DEVICE=
AUDIO_DEVICE=
AUDIO_CHANNELS=1
AUDIO_RATE=44100
STREAM_NO_AUDIO=false
STREAM_AUDIO_BOOST=false

OVERLAY_TEXT=https://theworldofrafex.blog
OVERLAY_TEXT_POS=bl
OVERLAY_TIMESTAMP=true
OVERLAY_LOGO_FILE=assets/logo.png
OVERLAY_LOGO_POS=tl
OVERLAY_LOGO_PAD=20
OVERLAY_LOGO_W=150
OVERLAY_BANNER=
OVERLAY_BANNER_POS=footer
