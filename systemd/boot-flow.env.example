# Configuracion del flujo de arranque post-WiFi.
# Copiar a /etc/raspi-streaming/boot-flow.env y editar.

# Inicia la transmision automaticamente despues de que la red y los servicios
# esten listos, respetando el retardo de estabilizacion de 10 minutos.
AUTO_STREAM_ENABLED=true

# Espera tras red/servicios antes de iniciar transmision. 600s (10 min) da
# margen amplio a que WiFi, USB (camara/mic) y modulos de kernel (bcm2835-codec)
# terminen de estabilizarse — con 120s se vieron fallos transitorios
# "Device or resource busy" al abrir la camara justo tras el arranque.
AUTO_STREAM_DELAY_SECONDS=600

# Servicio a iniciar automaticamente.
# Recomendado: streaming-overlay.service porque soporta audio por env y silencio AAC.
AUTO_STREAM_SERVICE=streaming-overlay.service

# Servicios que deben tener oportunidad de levantar antes del stream.
AUTO_STREAM_WAIT_SERVICES="web-api.service ngrok-web.service health-reporter.service"

# No iniciar streaming si no hay ruta default; evita iniciar en modo AP fallback.
AUTO_STREAM_REQUIRE_DEFAULT_ROUTE=true

# Audio base: mono por defecto.
AUTO_STREAM_AUDIO_CHANNELS=1
