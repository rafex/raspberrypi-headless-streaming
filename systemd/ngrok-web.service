[Unit]
Description=ngrok tunnel para portal Raspi Streaming
Documentation=https://github.com/rafex/raspberrypi-headless-streaming
After=network-online.target web-api.service
Wants=network-online.target web-api.service

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/raspi-streaming/ngrok.env
Environment="NGROK_BIN=ngrok"
ExecStart=/bin/sh -c 'command -v "$NGROK_BIN" >/dev/null 2>&1 || { echo "ngrok no encontrado: $NGROK_BIN"; exit 127; }; if [ -n "$NGROK_DOMAIN" ]; then exec "$NGROK_BIN" http --domain "$NGROK_DOMAIN" "$NGROK_LOCAL_URL" $NGROK_EXTRA_ARGS; else exec "$NGROK_BIN" http "$NGROK_LOCAL_URL" $NGROK_EXTRA_ARGS; fi'
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ngrok-web

[Install]
WantedBy=multi-user.target
