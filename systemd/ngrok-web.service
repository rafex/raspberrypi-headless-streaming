[Unit]
Description=ngrok tunnels para portal y SSH de Raspi Streaming
Documentation=https://github.com/rafex/raspberrypi-headless-streaming
After=network-online.target web-api.service
Wants=network-online.target web-api.service

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/raspi-streaming/ngrok.env
Environment="NGROK_BIN=ngrok"
Environment="NGROK_CONFIG=/etc/raspi-streaming/ngrok.yml"
ExecStart=/bin/sh -c 'command -v "$NGROK_BIN" >/dev/null 2>&1 || { echo "ngrok no encontrado: $NGROK_BIN"; exit 127; }; [ -f "$NGROK_CONFIG" ] || { echo "ngrok config no encontrado: $NGROK_CONFIG"; exit 1; }; if grep -q "^[[:space:]]*tunnels:" "$NGROK_CONFIG"; then exec "$NGROK_BIN" --config "$NGROK_CONFIG" start --all; elif [ -n "$NGROK_DOMAIN" ]; then exec "$NGROK_BIN" --config "$NGROK_CONFIG" http --domain "$NGROK_DOMAIN" "$NGROK_LOCAL_URL" $NGROK_EXTRA_ARGS; else exec "$NGROK_BIN" --config "$NGROK_CONFIG" http "$NGROK_LOCAL_URL" $NGROK_EXTRA_ARGS; fi'
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ngrok-web

[Install]
WantedBy=multi-user.target
