[Unit]
Description=Raspberry Pi Headless Streaming — Vista previa local (RTMP/MPEG-TS)
Documentation=https://github.com/rafex/raspberrypi-headless-streaming
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=__STREAM_USER__

Environment="STREAM_WIDTH=1280"
Environment="STREAM_HEIGHT=720"
Environment="STREAM_FPS=30"
Environment="STREAM_BITRATE=2500000"
Environment="STREAM_PRESET=veryfast"
Environment="PREVIEW_TRANSPORT=rtmp"
Environment="PREVIEW_PORT=1935"
Environment="PREVIEW_RTMP_NAME=preview"
Environment="PREVIEW_OVERLAY=true"

# Reutiliza cámara/audio/overlays de la configuración del stream en vivo
# (streaming.env), pero NUNCA su destino. PREVIEW_MODE=true hace que
# stream-overlay.sh fuerce URL/KEY/DUAL_URL vacíos incondicionalmente,
# después de leer todo lo demás — no depende del orden de mezcla de
# Environment=/EnvironmentFile= de systemd para esta garantía.
EnvironmentFile=-/etc/streaming.env
EnvironmentFile=-/etc/preview.env

Environment="PREVIEW_MODE=true"

WorkingDirectory=__REPO_DIR__

ExecStart=/bin/bash scripts/stream-overlay.sh \
    -w ${STREAM_WIDTH} \
    -h ${STREAM_HEIGHT} \
    -f ${STREAM_FPS} \
    -b ${STREAM_BITRATE} \
    --preset ${STREAM_PRESET}

RestartSec=10
Restart=on-failure

StandardOutput=journal
StandardError=journal
SyslogIdentifier=preview

Nice=-5

[Install]
WantedBy=multi-user.target
