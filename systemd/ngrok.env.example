# Copiar a /etc/raspi-streaming/ngrok.env
#
# El authtoken no va aqui. Va en:
#   /etc/raspi-streaming/ngrok.yml

# Binario de ngrok. Puede ser /usr/local/bin/ngrok o simplemente ngrok si está en PATH.
NGROK_BIN=ngrok

# Config YAML de ngrok v3. Debe contener:
# version: 3
# agent:
#   authtoken: <your-authtoken>
NGROK_CONFIG=/etc/raspi-streaming/ngrok.yml

# Dominio reservado opcional de ngrok, por ejemplo:
# NGROK_DOMAIN=raspi-streaming.ngrok.app
NGROK_DOMAIN=

# Puerto local del portal web.
NGROK_LOCAL_URL=https://127.0.0.1:8443

# Flags extra opcionales. Ejemplo:
# NGROK_EXTRA_ARGS=--basic-auth usuario:password
NGROK_EXTRA_ARGS=
