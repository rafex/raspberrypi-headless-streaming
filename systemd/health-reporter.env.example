# Copiar a /etc/raspi-streaming/health-reporter.env

# Endpoint publico que recibira POST JSON con estado de la Raspi.
HEALTH_ENDPOINT=

# Token opcional enviado como Authorization: Bearer <token>
HEALTH_TOKEN=

# Certificado cliente mTLS opcional para el backend publico.
BACKEND_CLIENT_CERT=/etc/raspi-streaming/backend-client/raspi-client.crt
BACKEND_CLIENT_KEY=/etc/raspi-streaming/backend-client/raspi-client.key

# Frecuencia de reporte.
HEALTH_INTERVAL_SECONDS=60
