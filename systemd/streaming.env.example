# Archivo de variables de entorno para el servicio systemd.
# Copiar a /etc/streaming.env y editar con los valores reales.
# Para aplicar los defaults actuales del repo sin perder keys locales:
#
# sudo ./scripts/apply-streaming-defaults.py
#
# sudo cp systemd/streaming.env.example /etc/streaming.env
# sudo nano /etc/streaming.env
# sudo chmod 600 /etc/streaming.env

# URL RTMP completa incluyendo el stream key
# YouTube Live:
RTMP_URL=rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx

# Facebook Live:
# RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp/xxxx

# Servidor local:
# RTMP_URL=rtmp://192.168.1.100/live/cam

# Parámetros de video
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
STREAM_BITRATE=4500000

# Preset de re-encoding (solo aplica con overlays)
# ultrafast, superfast, veryfast, faster, fast
STREAM_PRESET=veryfast

# Configuracion del portal / stream-overlay.sh
STREAM_PLATFORM=youtube
STREAM_KEY=
STREAM_DUAL=false
STREAM_KEY_META=
RTMP_URL_SECONDARY=

# Dispositivos. Si AUDIO_DEVICE queda vacio, el boot-flow prioriza BOYA,
# luego webcam, luego cualquier USB, y finalmente silencio AAC.
VIDEO_SOURCE=auto
VIDEO_DEVICE=
VIDEO_INPUT_FORMAT=
VIDEO_INPUT_WIDTH=
VIDEO_INPUT_HEIGHT=
VIDEO_INPUT_FPS=
AUDIO_SOURCE=auto
AUDIO_DEVICE=
AUDIO_CHANNELS=1
AUDIO_RATE=44100
STREAM_NO_AUDIO=false
STREAM_AUDIO_BOOST=false

# Overlays por defecto
OVERLAY_TEXT=https://theworldofrafex.blog
OVERLAY_TEXT_POS=bl
OVERLAY_TIMESTAMP=true
OVERLAY_LOGO_FILE=assets/logo.png
OVERLAY_LOGO_POS=tl
OVERLAY_LOGO_PAD=20
OVERLAY_LOGO_W=150
OVERLAY_BANNER=
OVERLAY_BANNER_POS=footer
