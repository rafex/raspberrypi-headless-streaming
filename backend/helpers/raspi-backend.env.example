# Config para que la Raspi reporte al backend publico.
HEALTH_ENDPOINT=https://streaming.rafex.io/v1/raspi/raspi3b/health
HEALTH_TOKEN=
HEALTH_INTERVAL_SECONDS=60

# Certificados cliente mTLS instalados por install-raspi-client-certs.sh
BACKEND_CLIENT_CERT=/etc/raspi-streaming/backend-client/raspi-client.crt
BACKEND_CLIENT_KEY=/etc/raspi-streaming/backend-client/raspi-client.key
